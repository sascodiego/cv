---
import cvData from '../data/cv-processed.json';

const { personal_info, skills, work_experience, education } = cvData;

const categoryMapping = {
	'Languages & Frameworks': 'Lenguajes y frameworks',
	'Databases & Obs': 'Bases de datos y mensajería',
	'Databases & Messaging': 'Bases de datos y mensajería',
	'Architecture & Protocols': 'Bases de datos y mensajería',
	'Infrastructure & DevOps': null,
	'Automation & QA': null,
	'IoT & Embedded': 'IoT y embebidos',
};

const SKILLS_PER_GROUP = 4;

const groupedSkills = Object.entries(
	 skills.reduce((groups, skill) => {
		const mappedCategory = categoryMapping[skill.category];
		if (!mappedCategory) return groups;
		if (!groups[mappedCategory]) groups[mappedCategory] = [];
		groups[mappedCategory].push(skill);
		return groups;
	}, {}),
)
	.map(([label, items]) => {
		const orderedItems = [...items].sort((a, b) => b.years_experience - a.years_experience);
		const visibleItems = orderedItems.slice(0, SKILLS_PER_GROUP).map((skill) => skill.name);
		return {
			label,
			items: visibleItems,
			extraCount: Math.max(0, orderedItems.length - visibleItems.length),
		};
	})
	.sort((a, b) => {
		const order = ['Lenguajes y frameworks', 'Bases de datos y mensajería', 'IoT y embebidos'];
		return order.indexOf(a.label) - order.indexOf(b.label);
	});

const summaryText = personal_info.about_me
	.split(/\n\s*\n/)[0]
	.replace(/\s+/g, ' ')
	.trim();

const sortedWorkExperience = [...work_experience].sort((a, b) => {
	const aEnd = a.end_date === '2026-06-10' ? '2999-12-31' : a.end_date;
	const bEnd = b.end_date === '2026-06-10' ? '2999-12-31' : b.end_date;
	return new Date(bEnd) - new Date(aEnd);
});

const sortedEducation = [...education].sort((a, b) => new Date(b.end_date) - new Date(a.end_date));

const splitSentences = (text) =>
	text
		.replace(/\s+/g, ' ')
		.trim()
		.split(/(?<=[.!?])\s+(?=[A-ZÁÉÍÓÚÜÑ¿¡])/)
		.filter(Boolean);

const formatBullets = (description, maxBullets = 2) =>
	splitSentences(description).slice(0, maxBullets).map((sentence) => sentence.replace(/\s+/g, ' ').trim());
---

<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="UTF-8" />
	<title>{personal_info.name} - CV</title>
	<style>
		@page {
			size: A4;
			margin: 7mm 9mm 7mm 9mm;
		}

		@media print {
			body {
				font-family: 'Times New Roman', Times, serif;
				font-size: 10.75pt;
				line-height: 1.26;
				color: #000;
				background: #fff;
				margin: 0;
				padding: 0;
				-webkit-print-color-adjust: exact;
				print-color-adjust: exact;
			}

			.cv-document {
				width: 100%;
				margin: 0;
				padding: 0;
			}

			.cv-header {
				text-align: center;
				padding-bottom: 7pt;
				margin-bottom: 7pt;
				border-bottom: 1pt solid #000;
			}

			.cv-header h1 {
				margin: 0;
				font-family: 'Times New Roman', Times, serif;
				font-size: 24pt;
				font-weight: bold;
				text-transform: uppercase;
				letter-spacing: 1pt;
				line-height: 1.01;
			}

			.professional-title {
				margin: 3pt 0 5pt;
				font-family: 'Times New Roman', Times, serif;
				font-size: 12pt;
				font-style: italic;
				font-weight: normal;
				color: #333;
				line-height: 1.2;
			}

			.contact-info {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: baseline;
				gap: 0;
				margin: 2pt 0 0;
				padding: 0;
			}

			.contact-item,
			.contact-separator {
				display: inline-flex;
				align-items: baseline;
				font-family: 'Times New Roman', Times, serif;
				font-size: 9.25pt;
				line-height: 1;
				color: #000;
				white-space: nowrap;
			}

			.contact-item {
				text-decoration: none;
			}

			.contact-item a {
				color: #000;
				text-decoration: none;
			}

			.contact-separator {
				padding: 0 4pt;
			}

			.summary-text {
				margin: 0 0 7pt;
				font-family: 'Times New Roman', Times, serif;
				font-size: 10.75pt;
				font-style: italic;
				line-height: 1.24;
				text-align: justify;
				color: #111;
			}

			.section {
				margin-top: 0;
			}

			h2.section-header {
				margin: 8pt 0 3pt;
				padding: 0 0 3pt;
				font-family: 'Times New Roman', Times, serif;
				font-size: 13pt;
				font-weight: bold;
				text-transform: uppercase;
				letter-spacing: 0.5pt;
				border-bottom: 1pt solid #000;
				page-break-after: avoid;
				page-break-inside: avoid;
				line-height: 1.12;
			}

			.entry {
				margin: 0 0 6pt;
				page-break-inside: avoid;
			}

			.entry-header {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 88pt;
				column-gap: 8pt;
				align-items: start;
				margin: 0 0 3pt;
			}

			h3.company-name,
			h3.institution-name,
			h3.project-name {
				margin: 0;
				font-family: 'Times New Roman', Times, serif;
				font-size: 12.25pt;
				font-weight: bold;
				line-height: 1.06;
			}

			.period {
				margin: 0;
				font-family: 'Times New Roman', Times, serif;
				font-size: 10pt;
				font-style: italic;
				font-weight: bold;
				white-space: nowrap;
				justify-self: end;
				text-align: right;
				color: #111;
			}

			.role-title,
			.degree-title,
			.project-title {
				margin: 0 0 4pt;
				font-family: 'Times New Roman', Times, serif;
				font-size: 11pt;
				font-weight: normal;
				line-height: 1.12;
			}

			.entry-bullets {
				margin: 4pt 0 0 13pt;
				padding: 0;
			}

			.entry-bullets li {
				margin: 0 0 2pt;
				font-family: 'Times New Roman', Times, serif;
				font-size: 10.25pt;
				line-height: 1.16;
			}

			.skills-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 5pt;
				margin: 0;
			}

			.skill-row {
				display: grid;
				grid-template-columns: 122pt minmax(0, 1fr);
				column-gap: 8pt;
				align-items: baseline;
			}

			.skill-label {
				font-family: 'Times New Roman', Times, serif;
				font-size: 10.6pt;
				font-weight: bold;
				line-height: 1.15;
			}

			.skill-items {
				font-family: 'Times New Roman', Times, serif;
				font-size: 10.1pt;
				line-height: 1.2;
			}

			.skill-more {
				font-style: italic;
				white-space: nowrap;
			}

			.section,
			.entry,
			.skills-grid {
				page-break-inside: avoid;
			}
		}

		@media screen {
			body {
				font-family: Arial, sans-serif;
				background: #f5f5f5;
				margin: 0;
				padding: 20px;
			}

			.cv-document {
				max-width: 210mm;
				margin: 0 auto;
				padding: 15mm;
				background: #fff;
				box-shadow: 0 2px 8px rgba(0,0,0,0.08);
			}
		}
	</style>
</head>
<body>
	<div class="cv-document">
		<header class="cv-header">
			<h1>{personal_info.name}</h1>
			<p class="professional-title">{personal_info.title}</p>
			<div class="contact-info">
				<!-- Contact items injected by Puppeteer -->
			</div>
		</header>

		<p class="summary-text">{summaryText}</p>

		<section class="section experience-section">
			<h2 class="section-header">EXPERIENCIA PROFESIONAL</h2>
			{sortedWorkExperience.map((entry) => (
				<article class="entry experience-entry">
					<div class="entry-header">
						<h3 class="company-name">{entry.company}</h3>
						<span class="period">{entry.period_text}</span>
					</div>
					<p class="role-title">{entry.role}</p>
					<ul class="entry-bullets">
						{formatBullets(entry.description, 2, 118).map((bullet) => (
							<li>{bullet}</li>
						))}
					</ul>
				</article>
			))}
		</section>

		<section class="section education-section">
			<h2 class="section-header">EDUCACIÓN</h2>
			{sortedEducation.map((entry) => (
				<article class="entry education-entry">
					<div class="entry-header">
						<h3 class="institution-name">{entry.institution}</h3>
						<span class="period">{entry.period_text}</span>
					</div>
					<p class="degree-title">
						{entry.degree}
						{entry.status ? ` - ${entry.status}` : ''}
					</p>
				</article>
			))}
		</section>

		<section class="section skills-section">
			<h2 class="section-header">HABILIDADES TÉCNICAS</h2>
			<div class="skills-grid">
				{groupedSkills.map((group) => (
					<div class="skill-row">
						<span class="skill-label">{group.label}</span>
						<span class="skill-items">
							{group.items.join(' · ')}
							{group.extraCount > 0 && (
								<span class="skill-more"> · +{group.extraCount} más</span>
							)}
						</span>
					</div>
				))}
			</div>
		</section>

	</div>
</body>
</html>
